JANUS_SECRET_KEY=change-me-local-dev-secret
DATABASE_URL=sqlite:////home/you/.local/share/janus/janus.db
JANUS_FERNET_KEY_PATH=/home/you/.local/share/janus/.janus_key
JANUS_LOG_FILE_PATH=/home/you/.local/state/janus/janus.log
JANUS_SERVER_MODE=true
# Alternative database backend example:
# DATABASE_URL=postgresql://username:password@localhost:5432/janus
# Microsoft 365 (Outlook, Teams) via Microsoft Graph; then run `uv run janus microsoft login`
# JANUS_MICROSOFT_CLIENT_ID=
# JANUS_MICROSOFT_TENANT_ID=
# Read-only Azure resource tools via DefaultAzureCredential (az login, service principal, ...)
# JANUS_AZURE_ENABLED=false
