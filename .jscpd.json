{
  "$schema": "https://json.schemastore.org/jscpd.json",
  "path": [
    "src/janus",
    "frontend/src"
  ],
  "format": [
    "python",
    "typescript",
    "tsx"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/__pycache__/**",
    "frontend/src/generated/**",
    "frontend/src/**/*.test.ts",
    "frontend/src/**/*.test.tsx",
    "frontend/src/**/*.stories.tsx",
    "frontend/src/**/*Fixtures.ts",
    "frontend/src/test/**"
  ],
  "minLines": 8,
  "minTokens": 70,
  "reporters": [
    "console",
    "json",
    "html"
  ],
  "output": "jscpd-report",
  "gitignore": true,
  "absolute": false,
  "silent": false,
  "threshold": 1
}
