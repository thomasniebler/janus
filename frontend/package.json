{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:types": "openapi-typescript src/generated/openapi.json -o src/generated/api.d.ts",
    "generate:types:check": "openapi-typescript src/generated/openapi.json -o src/generated/api.d.ts --check",
    "lint": "eslint .",
    "knip": "knip",
    "knip:ci": "knip --exclude exports,types",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "postcss": "^8.5.14",
    "react": "^19.2.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "knip": "^6.39.0",
    "openapi-typescript": "^7.10.1",
    "storybook": "^10.6.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.7",
    "vitest": "^5.0.3"
  }
}
