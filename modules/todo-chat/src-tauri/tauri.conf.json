{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Todo Chat",
  "version": "0.1.0",
  "identifier": "local.janus.todo-chat",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Todo Chat",
        "width": 440,
        "height": 900,
        "minWidth": 380,
        "minHeight": 520,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:*; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.svg"] }
}
